{
  "expo": {
    "name": "Pizzaria",
    "slug": "app-pizzaria-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EDE1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pizzaria.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F4EDE1"
      },
      "package": "com.pizzaria.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "090e91ba-241f-447a-812b-39bc43c6cd8d"
      }
    },
    "owner": "pizzaria-apps-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/090e91ba-241f-447a-812b-39bc43c6cd8d"
    }
  }
}
